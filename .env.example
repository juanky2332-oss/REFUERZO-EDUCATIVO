# -----------------------------------------------------------------------------
# REFUERZO EDUCATIVO — variables de entorno
#
# Copia este fichero a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: NUNCA subas una clave al repositorio.
# En Vercel, define estas variables en Project Settings → Environment Variables.
# -----------------------------------------------------------------------------

# --- Proveedor de IA (obligatorio: hace falta al menos una clave) -------------

# Opción A: OpenAI
OPENAI_API_KEY=

# Opción B: Anthropic
ANTHROPIC_API_KEY=

# Fuerza un proveedor concreto cuando hay varias claves: "openai" o "anthropic".
# Si se deja vacío, se usa OpenAI cuando hay OPENAI_API_KEY, y si no, Anthropic.
AI_PROVIDER=

# --- Modelos ------------------------------------------------------------------
# El modelo principal debe admitir imágenes (visión).
# OpenAI: gpt-4o (por defecto), gpt-5.4-mini, gpt-5.x…
# Anthropic: claude-sonnet-4-5 (por defecto), claude-haiku-4-5-20251001…
AI_MODEL=
AI_MODEL_FAST=

# Sólo para los modelos de razonamiento de OpenAI (gpt-5.x, o1, o3, o4):
# "minimal" | "low" | "medium" | "high". Por defecto "medium".
AI_REASONING_EFFORT=

# --- Límite de uso ------------------------------------------------------------
# Peticiones permitidas por cliente dentro de la ventana.
RATE_LIMIT_SOLVE=20
RATE_LIMIT_GENERATE=10
RATE_LIMIT_VENTANA_MS=60000

# --- Endpoints alternativos (opcional) ----------------------------------------
# Útil para pasar por un proxy o una pasarela como Vercel AI Gateway.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
